# BrAInBox backend settings. Copy to `.env` for local development:   cp .env.example .env
# Values here are safe dev placeholders, never real secrets. NEVER commit `.env` or key files.
# Production: set these as environment variables / secrets on the host (docs/deployment.md).
# The api and ai_service refuse to start with ENVIRONMENT=prod and an unsafe value.

# ================================================================ general (both services)
# dev | test | prod ("production" is accepted as prod; anything else stops the start-up)
ENVIRONMENT=dev
# DEBUG | INFO | WARNING | ERROR | CRITICAL (prod writes JSON lines, emails are removed)
LOG_LEVEL=INFO
# Version shown in /docs and /health of both services
API_VERSION=0.1.0

# ================================================================ database
# User for the local docker compose Postgres container (dev only)
POSTGRES_USER=brainbox
# Password for the local docker compose Postgres container (dev only)
POSTGRES_PASSWORD=brainbox
# Database name for the local docker compose Postgres container (dev only)
POSTGRES_DB=brainbox
# Async SQLAlchemy URL; prod: postgresql+asyncpg://USER:PASSWORD@HOST/DB?ssl=require
DATABASE_URL=postgresql+asyncpg://brainbox:brainbox@localhost:5432/brainbox
# Separate database for pytest's @pytest.mark.db tests (never the real one)
TEST_DATABASE_URL=
# API image only: false skips `alembic upgrade head` when the container starts
RUN_MIGRATIONS=true

# ================================================================ Firebase / Google Cloud
# Firebase project id (Project settings > General); needed to check login tokens
FIREBASE_PROJECT_ID=
# Firebase Web API key (public); only scripts/get_test_token.py uses it
FIREBASE_WEB_API_KEY=
# Path to the Firebase service-account JSON (keep it in ./secrets/, git-ignored); empty on Cloud Run
GOOGLE_APPLICATION_CREDENTIALS=
# Firebase Storage bucket, e.g. your-project.firebasestorage.app (required in prod)
STORAGE_BUCKET=
# Dev only, no bucket: folder for uploads shared by the api and the ai_service
LOCAL_STORAGE_DIR=data/local_storage
# Dev only, no bucket: folder for Learn tab uploads
UPLOAD_DIR=data/local_storage/learn_uploads
# Learn uploads larger than this many MB are refused (413)
MAX_UPLOAD_MB=10
# Public URL of the logo used in docs and emails (an https URL shows it in emails)
LOGO_URL=/static/brand/logo_horizontal_1200.png

# ================================================================ api <-> ai_service
# Where the api finds the ai_service (prod: its https URL)
AI_SERVICE_URL=http://localhost:8001
# Shared secret in the X-Service-Token header; prod: 32+ random chars (python -c "import secrets; print(secrets.token_urlsafe(48))")
AI_SERVICE_TOKEN=dev-service-token
# Seconds the api waits for an ai_service answer (paper generation is slow)
AI_SERVICE_TIMEOUT_SECONDS=180
# Prod on Cloud Run: the ai_service URL, so calls carry a Google identity token (empty = none)
AI_SERVICE_AUDIENCE=

# ================================================================ api: browsers, rate limits, jobs
# Browser origins allowed by CORS, comma-separated; "*" inside an entry works in dev only
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*
# Admin portal origin(s) in prod, exact https only, e.g. https://admin.example.org
ADMIN_ORIGINS=
# Requests per minute per client IP on sign-up / email-code / password-reset routes (0 = off)
RATE_LIMIT_AUTH_PER_MINUTE=10
# Requests per minute per login on routes that start AI work (0 = off)
RATE_LIMIT_AI_PER_MINUTE=20
# Proxies in front of the api that append to X-Forwarded-For (Cloud Run = 1; 0 = use the socket IP)
RATE_LIMIT_PROXY_HOPS=1
# How AI jobs run: local (in-process, dev / single server) | cloudtasks (Google Cloud Tasks)
JOB_RUNNER=local
# cloudtasks: Google Cloud project of the queue (empty = FIREBASE_PROJECT_ID)
CLOUD_TASKS_PROJECT=
# cloudtasks: region of the queue
CLOUD_TASKS_LOCATION=asia-south1
# cloudtasks: queue name
CLOUD_TASKS_QUEUE=brainbox-jobs
# cloudtasks: public https URL of this api (the queue calls it back); required with cloudtasks
JOBS_TARGET_URL=
# cloudtasks: service account email the queue signs its calls with (optional)
CLOUD_TASKS_SERVICE_ACCOUNT=
# cloudtasks: seconds one job may run
CLOUD_TASKS_DEADLINE_SECONDS=600

# ================================================================ api: per-student daily limits (0 = no limit)
# Written-answer evaluations per student per 24 hours
EVALUATIONS_DAILY_LIMIT=30
# Handwriting OCR requests per student per 24 hours
OCR_DAILY_LIMIT_PER_USER=10
# Generated model papers per student per 24 hours
PAPERS_DAILY_LIMIT=5
# Community posts per student per 24 hours
COMMUNITY_POSTS_DAILY_LIMIT=20
# AI visuals per student per 24 hours
VISUALS_DAILY_LIMIT=20
# Most photo pages for one handwritten answer
ANSWER_MAX_PAGES=6
# Largest photo page of a handwritten answer, in MB
ANSWER_IMAGE_MAX_MB=8

# ================================================================ api: content
# Days a signed image URL from Storage stays valid (7 = the maximum)
VISUAL_URL_EXPIRY_DAYS=7
# Dev only, no bucket: base URL for image links (empty = the address the app used)
PUBLIC_BASE_URL=
# YouTube Data API v3 key for video recommendations (empty = no videos)
YOUTUBE_API_KEY=
# A/L exam date per year as JSON, e.g. {"2027": "2027-08-02"} (empty = no countdown)
AL_EXAM_DATES={}

# ================================================================ api: auth codes and email
# Secret mixed into the 6-digit code hashes; prod: 32+ random chars, different from AI_SERVICE_TOKEN
AUTH_CODE_SECRET=dev-only-change-me
# console = print emails to the log (dev) | smtp = really send them (required in prod)
EMAIL_BACKEND=console
# SMTP server, e.g. smtp.gmail.com
SMTP_HOST=
# SMTP port: 587 = STARTTLS, 465 = SSL
SMTP_PORT=587
# SMTP login (the sending mailbox)
SMTP_USER=
# SMTP password (Gmail: an App Password, not the account password)
SMTP_PASSWORD=
# Use STARTTLS (port 587)
SMTP_USE_TLS=true
# Use SSL from the start (port 465 turns this on by itself)
SMTP_USE_SSL=false
# Seconds before giving up on the SMTP server
SMTP_TIMEOUT_SECONDS=15
# Sender shown to students; use the SMTP_USER address so mail does not land in Spam
EMAIL_FROM=BrAInBox <no-reply@example.com>

# ================================================================ api: dev-only switches (prod refuses to start if any is true)
# Dev: accept "Bearer dev-token" / "Bearer dev-admin" from this computer, without Firebase
DEV_LOGIN_ENABLED=false
# Dev: include the correct answers in generated papers
DEBUG_SHOW_ANSWERS=false
# Dev: return the 6-digit email code in the API response as "dev_code"
DEV_EXPOSE_CODES=false
# Dev seed: make this Firebase uid an admin (scripts/seed_dev.py, with SEED_ADMIN_EMAIL)
SEED_ADMIN_FIREBASE_UID=
# Dev seed: email of that admin
SEED_ADMIN_EMAIL=

# ================================================================ ai_service: AI providers
# true = deterministic fake AI, no keys, no cost (prod must be false)
USE_FAKE_AI=true
# Gemini API key from https://aistudio.google.com/apikey (required in prod)
GEMINI_API_KEY=
# Main Gemini text model
GEMINI_MODEL=gemini-3.8-flash
# Model tried when the main one is busy (429 / 5xx); empty = no fallback
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Gemini embedding model for the knowledge base search
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Embedding size; must match vector(768) in the database (do not change)
EMBEDDING_DIM=768
# Learn notes / summaries: mock | gemini (empty = mock with fake AI, else gemini; prod must not be mock)
LLM_PROVIDER=
# Key for LLM_PROVIDER=gemini (empty = GEMINI_API_KEY)
LLM_API_KEY=
# Model for LLM_PROVIDER=gemini (empty = GEMINI_MODEL)
LLM_MODEL=
# Randomness of generated text (0 = most predictable)
LLM_TEMPERATURE=0.2
# Longest model answer, in tokens
LLM_MAX_OUTPUT_TOKENS=4096
# Retries when the model fails or answers invalid JSON
LLM_MAX_RETRIES=3
# Seconds to wait for one model call
LLM_TIMEOUT_SECONDS=60
# Longest text sent to the model, in characters
MAX_INPUT_CHARS=60000
# Texts embedded per embedding request
EMBEDDING_BATCH_SIZE=100

# ================================================================ ai_service: images and diagrams
# Who draws illustrations: cloudflare (free daily allowance) | gemini (paid); no key = diagrams only
IMAGE_PROVIDER=cloudflare
# Image model for IMAGE_PROVIDER=gemini
IMAGE_MODEL=gemini-2.5-flash-image
# Cloudflare account id (Workers AI)
CLOUDFLARE_ACCOUNT_ID=
# Cloudflare API token with Workers AI access
CLOUDFLARE_API_TOKEN=
# Cloudflare image model
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# Seconds to wait for one picture
IMAGE_TIMEOUT_SECONDS=60
# Kroki server that turns Mermaid diagrams into PNG (free; can be self-hosted)
KROKI_URL=https://kroki.io
# Seconds to wait for Kroki
KROKI_TIMEOUT_SECONDS=15

# ================================================================ ai_service: OCR
# Language hints for Google Cloud Vision handwriting OCR, comma-separated
OCR_LANGUAGE_HINTS=en
# Path to tesseract for scanned PDFs during knowledge base ingestion (empty = find on PATH)
TESSERACT_CMD=

# ================================================================ ai_service: app-wide daily caps (0 = no cap, paid accounts only)
# Gemini text requests per day, all features together
GEMINI_DAILY_LIMIT=200
# Embedding requests per day
EMBEDDING_DAILY_LIMIT=900
# Pictures per day
IMAGE_DAILY_LIMIT=200
# Cloud Vision OCR pages per day (first 1,000 a month are free)
OCR_DAILY_LIMIT=30

# ================================================================ ai_service: marking and search tuning
# Similarity from which a marking point counts as covered
EVAL_COVERED_SIMILARITY=0.80
# Similarity from which a marking point counts as partly covered
EVAL_PARTIAL_SIMILARITY=0.65
# Similarity from which an existing misconception is reused
MISCONCEPTION_REUSE_SIMILARITY=0.88
# Similarity from which a generated question is a duplicate
QUESTION_DUPLICATE_SIMILARITY=0.92
# Knowledge base chunk size, in tokens
RAG_CHUNK_TOKENS=500
# Overlap between chunks, in tokens
RAG_CHUNK_OVERLAP=50
# Chunks returned per search
RAG_TOP_K=8
# Weight of vector similarity vs keyword match in search (0-1)
RAG_VECTOR_WEIGHT=0.6

# Copy this file to `.env` and fill in the values:   cp .env.example .env
# NEVER commit `.env` or any service-account JSON file.

# ---------------------------------------------------------------- general
# dev | test | prod
ENVIRONMENT=dev
LOG_LEVEL=INFO

# ---------------------------------------------------------------- database
# Used by docker compose to create the Postgres container.
POSTGRES_USER=brainbox
POSTGRES_PASSWORD=brainbox
POSTGRES_DB=brainbox
# Async SQLAlchemy URL. "localhost" works when you run code on your machine;
# docker compose overrides it with host "db" inside the containers.
DATABASE_URL=postgresql+asyncpg://brainbox:brainbox@localhost:5432/brainbox
# Optional: a separate database for pytest's @pytest.mark.db tests.
# TEST_DATABASE_URL=postgresql+asyncpg://brainbox:brainbox@localhost:5432/brainbox_test

# ---------------------------------------------------------------- Firebase / Google Cloud
# Firebase project id (Project settings -> General). Needed to verify ID tokens.
FIREBASE_PROJECT_ID=
# Path to the service-account JSON (download from Firebase -> Project settings -> Service accounts).
# Keep it in ./secrets/ (git-ignored). Used for Storage signed URLs and Cloud Vision OCR.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json
# Firebase Storage bucket, e.g. brainbox-xxxx.appspot.com
STORAGE_BUCKET=

# ---------------------------------------------------------------- api <-> ai_service
# Where the api finds the AI service (docker compose overrides it to http://ai_service:8001).
AI_SERVICE_URL=http://localhost:8001
# Shared secret sent in the X-Service-Token header. Use a long random value outside dev:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVICE_TOKEN=dev-service-token

# ---------------------------------------------------------------- AI providers (ai_service only)
# Gemini API key (https://aistudio.google.com/apikey). Empty = fake providers are used.
GEMINI_API_KEY=
# true = always use the deterministic fakes in ai_service/providers/fakes.py (no cost, offline)
USE_FAKE_AI=true
# Optional model overrides
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# IMAGE_MODEL=imagen-4.0-generate-001

# ---------------------------------------------------------------- other APIs
# YouTube Data API v3 key (Google Cloud console). Empty = no YouTube results.
YOUTUBE_API_KEY=

# ---------------------------------------------------------------- api behaviour
# Comma-separated allowed origins. "*" works inside an entry: http://localhost:* allows any port
# (the Flutter web / admin portal dev server picks a random port).
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*
# How AI jobs run: local (in-process BackgroundTasks, for dev) | cloudtasks (production, TODO)
JOB_RUNNER=local
# Public URL of the logo used in docs/emails (default: served by the api itself)
LOGO_URL=/static/brand/logo_horizontal_1200.png

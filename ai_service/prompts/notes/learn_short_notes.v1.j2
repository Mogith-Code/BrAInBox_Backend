[
  {"type":"heading","text":"{{ topic_title }}: short notes"},
  {"type":"bullet_list","items":["...", "..."]}{% if include_past_paper_tips %},
  {"type":"tip","title":"Past-paper tip","text":"..."}{% endif %}

]
